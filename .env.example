# Copy to .env and fill in the key. Never commit .env.
ANTHROPIC_API_KEY=

GENERATION_MODEL=claude-sonnet-5-5
EXTRACTION_MODEL=claude-haiku-5-5
JUDGE_MODEL=claude-opus-5-5

EMBEDDING_MODEL=BAAI/bge-m3
QDRANT_URL=http://qdrant:6333

# Controlled variables (identical for all 4 pipelines, see spec section 3)
CONTEXT_TOKEN_BUDGET=2048
MAX_OUTPUT_TOKENS=1024
TEMPERATURE=0

# Spending cap per run (EUR)
MAX_BUDGET_EUR=5
